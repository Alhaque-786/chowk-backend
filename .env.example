# Copy to .env and adjust. .env is gitignored -- never commit real secrets.
#
# Every variable here is read exactly once, in internal/config. Nothing else in
# the codebase calls os.Getenv, so this file is the complete list of knobs.

# local | staging | production
APP_ENV=local

PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=20s

# Comma-separated. The Next.js dev server for local work; your real domains in
# production. Never use "*" with AllowCredentials -- browsers reject it, and it
# would defeat the point of CORS anyway.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matches docker-compose.yml. sslmode=disable is for local ONLY; production must
# use verify-full, or the connection can be transparently MITM'd.
POSTGRES_DSN=postgres://cloudkitchen:localdev@localhost:5432/cloudkitchen?sslmode=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# REDIS_URL overrides the three settings above when set, and is how every hosted
# provider hands you credentials. The SCHEME carries TLS — there is deliberately
# no REDIS_TLS flag, because a second source of truth can disagree with the URL.
#
#   rediss://default:<token>@<name>.upstash.io:6379
#
# Plaintext redis:// to anything other than loopback is refused at startup: the
# password goes out in the clear on the first command, and this cache holds
# session and OTP-throttling keys.
REDIS_URL=

# Minimum 32 characters -- config.Load refuses to boot below that, because a
# short HMAC secret is brute-forceable and a forged token is full account access.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Short access token, long refresh token. The access token cannot be revoked, so
# its lifetime is the window an attacker gets with a stolen one -- keep it small.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

OTP_TTL=5m
OTP_MAX_ATTEMPTS=5

# ~250ms per hash on current hardware. Raising this is safe: existing hashes are
# transparently upgraded on the user's next successful login.
BCRYPT_COST=12

# Razorpay is the default for India. KEY_SECRET and WEBHOOK_SECRET are required
# in production and config.Load will refuse to start without them.
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
STORAGE_PUBLIC_URL=http://localhost:8080/static


# --- Observability -----------------------------------------------------------
#
# METRICS_ENABLED gates BOTH /metrics and /status. Neither is authenticated -- the
# thing that scrapes them is an agent with no user token -- so both must be
# restricted at the ingress or bound to a separate port. They expose internal
# topology: route shapes, traffic volume, circuit-breaker state, outbox backlog.
# Default is true.
METRICS_ENABLED=true

# OpenTelemetry. Off by default because it needs a collector to send to; without
# TRACING_ENDPOINT there is nowhere for spans to go.
TRACING_ENABLED=false
TRACING_ENDPOINT=

# Fraction of requests traced, in [0,1]. 1.0 locally so every request is
# inspectable while developing. PRODUCTION MUST LOWER THIS -- tracing every request
# at volume costs more in egress and collector capacity than the traces are worth,
# and config.Load clamps out-of-range values rather than trusting the input.
TRACING_SAMPLE_RATIO=1.0

# Stamped onto traces and metrics so you can tell which build produced a span.
# Set this from the git SHA in CI; "dev" is the default and is only right locally.
APP_VERSION=dev

# debug | info | warn | error
LOG_LEVEL=debug
# json for deployed environments (aggregators index the fields), text locally.
LOG_FORMAT=text
